NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-db-status
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_REGISTRATION_DEMO=disabled
NEXT_PUBLIC_REGISTRATION_DEMO_SCENARIO=standard
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-server-only
PUBLIC_APP_ORIGIN=http://127.0.0.1:3100

ACCOUNT_DEMO_ENABLED=false
CRON_SECRET=replace-with-a-random-server-only-secret

# IA (sugestão de prioridade). Trocável: IA_PROVIDER=gemini | groq.
# Chaves SÓ no backend (sem prefixo NEXT_PUBLIC_, nunca vão ao navegador).
IA_PROVIDER=gemini
# Groq — chave em https://console.groq.com (API Keys).
GROQ_API_KEY=replace-with-your-groq-api-key
# Gemini — chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Opcional: força um modelo específico (senão usa o default do provedor).
# IA_MODEL=
