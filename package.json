{
  "name": "zelo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:classificacao": "vitest run --config vitest.eval.config.mts",
    "test:db:priority": "vitest run --config vitest.db.config.mts tests/db/rule-priority.integration.test.ts",
    "test:db:account-demo": "vitest run --config vitest.db.config.mts tests/db/account-demo.integration.test.ts",
    "test:db:demo": "vitest run --config vitest.db.config.mts tests/db/demo-occurrences.integration.test.ts",
    "test:db:queue": "vitest run --config vitest.db.config.mts tests/db/queue.integration.test.ts",
    "test:db:uploads": "vitest run --config vitest.db.config.mts tests/db/uploads.integration.test.ts",
    "test:db": "SUPABASE_TELEMETRY_DISABLED=1 supabase test db --local --network-id zelo-local-loopback supabase/tests/database",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "db:demo": "node --experimental-transform-types --conditions=react-server scripts/db-demo.mjs",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "supabase stop --project-id zelo-local",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:types": "node scripts/db-types.mjs",
    "db:smtp:prepare": "node scripts/db-smtp.mjs prepare",
    "db:smtp:check": "node scripts/db-smtp.mjs check",
    "db:smtp:start": "node scripts/db-smtp.mjs start",
    "db:smtp:restore": "node scripts/db-smtp.mjs restore",
    "test:db:concurrency": "node tests/db/occurrences-concurrency.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "file-type": "22.3.0",
    "mp4box": "2.6.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supabase": "2.122.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vercel": "65.16.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
